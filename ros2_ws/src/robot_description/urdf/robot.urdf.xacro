<?xml version="1.0"?>

<!-- ================================================= -->
<!-- 差速轮式移动机器人模型 -->
<!-- 使用 ROS2 Humble + URDF + Xacro -->
<!-- ================================================= -->

<robot name="my_robot"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="lidar_mode" default="2d"/>
    <xacro:property name="multi_ring" value="${'$(arg lidar_mode)' == '3d'}"/>

    <!-- ============================================= -->
    <!-- 1. 定义机器人整体尺寸参数 -->
    <!-- ============================================= -->

    <xacro:property name="body_length" value="0.30"/>
    <xacro:property name="body_width" value="0.22"/>
    <xacro:property name="body_height" value="0.10"/>

    <xacro:property name="wheel_radius" value="0.05"/>
    <xacro:property name="wheel_width" value="0.025"/>
    <xacro:property name="wheel_y" value="0.1225"/>

    <xacro:property name="caster_radius" value="0.025"/>

    <!-- ============================================= -->
    <!-- 2. 地面参考坐标 base_footprint -->
    <!-- ============================================= -->

    <link name="base_footprint"/>

    <!-- ============================================= -->
    <!-- 3. 机器人底盘 base_link -->
    <!-- ============================================= -->

    <link name="base_link">

        <!-- 底盘外观 -->
        <visual>
            <geometry>
                <box size="${body_length} ${body_width} ${body_height}"/>
            </geometry>

            <!-- 蓝色材质 -->
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>

        <!-- 底盘碰撞模型 -->
        <collision>
            <geometry>
                <box size="${body_length} ${body_width} ${body_height}"/>
            </geometry>
        </collision>

        <!-- 底盘物理属性 -->
        <inertial>
            <origin xyz="-0.03 0 0" rpy="0 0 0"/>

            <mass value="2.0"/>

            <inertia
                ixx="0.009733"
                ixy="0"
                ixz="0"
                iyy="0.016667"
                iyz="0"
                izz="0.023067"/>
        </inertial>

    </link>

    <!-- base_footprint 与底盘连接 -->
    <!-- 底盘中心距离地面 0.10 米 -->

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.10" rpy="0 0 0"/>
    </joint>


    <!-- ============================================= -->
    <!-- 4. 左驱动轮 left_wheel -->
    <!-- ============================================= -->

    <link name="left_wheel">

        <!-- 左轮外观 -->
        <visual>

            <!-- 圆柱体默认沿 Z 轴 -->
            <!-- 绕 X 轴旋转 90 度，使轮轴沿 Y 轴 -->

            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <geometry>
                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_width}"/>
            </geometry>

            <material name="black">
                <color rgba="0.05 0.05 0.05 1"/>
            </material>

        </visual>

        <!-- 左轮碰撞模型 -->
        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <geometry>
                <cylinder
                    radius="${wheel_radius - 0.002}"
                    length="${wheel_width}"/>
            </geometry>
        </collision>

        <!-- 胎面中央比胎肩高 2 mm，保留外廓并稳定平地接触位置。 -->
        <collision name="left_tread">
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="0.003"/>
            </geometry>
        </collision>

        <!-- 左轮质量和转动惯量 -->
        <inertial>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <mass value="0.2"/>

            <inertia
                ixx="0.00012917"
                ixy="0"
                ixz="0"
                iyy="0.00012917"
                iyz="0"
                izz="0.00025"/>
        </inertial>

    </link>


    <!-- 左轮关节 -->
    <joint name="left_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="left_wheel"/>

        <!-- 左轮位于机器人左侧 -->
        <origin xyz="0 ${wheel_y} -0.05" rpy="0 0 0"/>

        <!-- 绕 Y 轴旋转 -->
        <axis xyz="0 1 0"/>

    </joint>


    <!-- ============================================= -->
    <!-- 5. 右驱动轮 right_wheel -->
    <!-- ============================================= -->

    <link name="right_wheel">

        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <geometry>
                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_width}"/>
            </geometry>

            <material name="black">
                <color rgba="0.05 0.05 0.05 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <geometry>
                <cylinder
                    radius="${wheel_radius - 0.002}"
                    length="${wheel_width}"/>
            </geometry>
        </collision>

        <!-- 胎面中央比胎肩高 2 mm，保留外廓并稳定平地接触位置。 -->
        <collision name="right_tread">
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="0.003"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <mass value="0.2"/>

            <inertia
                ixx="0.00012917"
                ixy="0"
                ixz="0"
                iyy="0.00012917"
                iyz="0"
                izz="0.00025"/>
        </inertial>

    </link>


    <!-- 右轮关节 -->
    <joint name="right_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="right_wheel"/>

        <!-- 右轮位于机器人右侧 -->
        <origin xyz="0 -${wheel_y} -0.05" rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

    </joint>


    <!-- ============================================= -->
    <!-- 6. 后方辅助支撑轮 caster_wheel -->
    <!-- ============================================= -->

    <link name="caster_wheel">

        <visual>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>

            <material name="gray">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>

        <collision>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.05"/>

            <inertia
                ixx="0.0000125"
                ixy="0"
                ixz="0"
                iyy="0.0000125"
                iyz="0"
                izz="0.0000125"/>
        </inertial>

    </link>


    <!-- 辅助轮固定在底盘后部 -->
    <joint name="caster_joint" type="fixed">

        <parent link="base_link"/>
        <child link="caster_wheel"/>

        <origin xyz="-0.11 0 -0.075" rpy="0 0 0"/>

    </joint>

    <!-- 固定球形脚轮使用低切向摩擦近似自由滚动。 -->
    <gazebo reference="caster_wheel">
        <mu1>0.05</mu1>
        <mu2>0.05</mu2>
    </gazebo>


    <!-- ============================================= -->
    <!-- 7. 激光雷达 lidar_link -->
    <!-- ============================================= -->

    <link name="lidar_link">

        <visual>
            <geometry>
                <cylinder radius="0.035" length="0.04"/>
            </geometry>

            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>

        <collision>
            <geometry>
                <cylinder radius="0.035" length="0.04"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.1"/>

            <inertia
                ixx="0.00004396"
                ixy="0"
                ixz="0"
                iyy="0.00004396"
                iyz="0"
                izz="0.00006125"/>
        </inertial>

    </link>


<!-- ============================================= -->
<!-- Gazebo 2D 激光雷达传感器 -->
<!-- ============================================= -->

<gazebo reference="lidar_link">

    <sensor name="lidar_sensor" type="gpu_lidar">

        <!-- 雷达扫描频率：10Hz -->
        <update_rate>10</update_rate>

        <!-- Gazebo 传感器话题 -->
        <topic>${'/lidar' if multi_ring else '/scan'}</topic>
        <!-- 指定雷达消息使用的 TF 坐标系 -->
	<gz_frame_id>lidar_link</gz_frame_id>

        <!-- 始终开启扫描 -->
        <always_on>true</always_on>

        <!-- 显示扫描结果 -->
        <visualize>true</visualize>

        <!-- 激光雷达参数 -->
        <lidar>

            <scan>

                <!-- 水平方向：360度扫描 -->
                <horizontal>
                    <samples>360</samples>
                    <resolution>1</resolution>
                    <min_angle>-3.14159265</min_angle>
                    <max_angle>3.14159265</max_angle>
                </horizontal>

                <!-- 3D mode uses 2-degree steps. Ring 10 is horizontal. -->
                <vertical>
                    <samples>${16 if multi_ring else 1}</samples>
                    <resolution>1</resolution>
                    <min_angle>${radians(-20) if multi_ring else 0}</min_angle>
                    <max_angle>${radians(10) if multi_ring else 0}</max_angle>
                </vertical>

            </scan>

            <!-- 测量距离 -->
            <range>
                <min>0.12</min>
                <max>8.0</max>
                <resolution>0.01</resolution>
            </range>

        </lidar>

    </sensor>

</gazebo>

    <!-- 雷达固定在底盘顶部 -->
    <joint name="lidar_joint" type="fixed">

        <parent link="base_link"/>
        <child link="lidar_link"/>

        <origin xyz="0 0 0.08" rpy="0 0 0"/>

    </joint>
    
    <!-- ============================================= -->
    <!-- 8. Gazebo Harmonic 差速驱动插件 -->
    <!-- ============================================= -->

    <gazebo>
        <plugin
            filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">

            <!-- 左右驱动轮关节 -->
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>

            <!-- 两个驱动轮中心距离 -->
            <wheel_separation>0.245</wheel_separation>

            <!-- 驱动轮半径 -->
            <wheel_radius>0.05</wheel_radius>

            <!-- Gazebo 速度控制话题 -->
            <topic>/cmd_vel</topic>

            <!-- 里程计话题 -->
            <odom_topic>/model/lk1209_robot/odometry</odom_topic>

            <!-- 坐标系 -->
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>

            <!-- 里程计发布频率 -->
            <odom_publish_frequency>50</odom_publish_frequency>

        </plugin>
    </gazebo>

</robot>

